# Optional: Vercel Blob RW token (automatically configured in Vercel; local dev falls back to .data/)
BLOB_READ_WRITE_TOKEN=

# Optional: Resend API key for transactional email reminders & event updates (3,000 free emails/month)
RESEND_API_KEY=
# Sender identity (must be a verified domain on Resend to email arbitrary guests, e.g. "invited <hello@yourdomain.com>")
INVITED_FROM_EMAIL=invited <onboarding@resend.dev>
# Public canonical URL used in email links (auto-detected from Vercel / request origin when unset)
NEXT_PUBLIC_APP_URL=

# Optional: Web Push VAPID keys for account-free browser push notifications (`npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@invited.app
