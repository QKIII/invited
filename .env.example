# Optional: Vercel Blob RW token (automatically configured in Vercel; local dev falls back to .data/)
BLOB_READ_WRITE_TOKEN=

# Optional: Web Push VAPID keys for account-free browser push notifications (`npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@invited.app
